    "patch-package": "^8.0.1",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.73.1",
    "react-hot-toast": "^2.6.0",
    "react-paginate": "^8.3.0",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.67",
    "zustand": "^5.0.14"
