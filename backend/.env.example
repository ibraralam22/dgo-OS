# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dgo_crm?schema=public"

# Cache Configuration (Redis)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication Config
JWT_SECRET="dgo_super_secret_access_token_key_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dgo_super_secret_refresh_token_key_change_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# Swagger Documentation Path
SWAGGER_PATH="api/docs"
