datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// Organizations represents the B2B Tenant entity
model Organization {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(255)
  subdomain         String             @db.VarChar(100)
  status            String             @default("active") @db.VarChar(50) // active, suspended, trial
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?          @db.Timestamptz(6)
  
  // Relations
  userOrganizations UserOrganization[]
  auditLogs         AuditLog[]
  roles             Role[]
  leads             Lead[]
  accounts          Account[]
  contacts          Contact[]

  @@map("organizations")
}

/// Users represents all internal employees and external client administrators
model User {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String             @db.VarChar(255)
  passwordHash      String?            @db.VarChar(255) // Nullable to natively support passwordless/Passkey login
  firstName         String             @db.VarChar(100)
  lastName          String             @db.VarChar(100)
  phone             String?            @db.VarChar(50)
  status            String             @default("pending") @db.VarChar(50) // pending, active, suspended
  timezone          String             @default("UTC") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?          @db.Timestamptz(6)

  // Relations
  userOrganizations UserOrganization[]
  userSessions      UserSession[]
  auditLogs         AuditLog[]
  ownedLeads        Lead[]

  @@map("users")
}

/// Roles represents role assignments for users within organizations
model Role {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(100)
  description       String?            @db.Text
  organizationId    String?            @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  deletedAt         DateTime?          @db.Timestamptz(6)

  // Relations
  rolePermissions   RolePermission[]
  userOrganizations UserOrganization[]
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([name, organizationId])
  @@map("roles")
}

/// Permissions represents granular functional permissions linked to roles
model Permission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String           @unique @db.VarChar(100) // e.g. 'leads:write', 'billing:approve'
  description     String?          @db.Text
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?        @db.Timestamptz(6)

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

/// Many-to-Many join table mapping roles and permissions
model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Join table mapping users to organizations with a specific role
model UserOrganization {
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  roleId         String       @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?    @db.Timestamptz(6)

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, organizationId])
  @@index([roleId])
  @@index([organizationId])
  @@map("user_organizations")
}

/// Active login sessions for refresh token rotation tracking
model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @db.Uuid
  tokenFamilyId    String   @db.Uuid
  refreshTokenHash String   @unique @db.VarChar(255)
  ipAddress        String?  @db.VarChar(45)
  userAgent        String?  @db.Text
  expiresAt        DateTime @db.Timestamptz(6)
  isRevoked        Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenFamilyId])
  @@index([userId])
  @@map("user_sessions")
}

/// Immutable Audit Log records tracking security and configuration updates
model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?       @db.Uuid
  userId         String?       @db.Uuid
  action         String        @db.VarChar(100) // e.g. auth.login, organization.update
  resourceName   String        @db.VarChar(100) // e.g. billing, lead
  resourceId     String?       @db.Uuid
  payloadBefore  Json?
  payloadAfter   Json?
  ipAddress      String?       @db.VarChar(45)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Integration Webhook Logs table serving as an idempotence guard
model IntegrationWebhookLog {
  id          String   @id @db.VarChar(255) // Stripe event id (evt_...)
  source      String   @db.VarChar(100)     // e.g. stripe
  processedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("integration_webhook_logs")
}

/// B2B Customer Relationship Leads
model Lead {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String        @db.Uuid
  ownerId                String?       @db.Uuid
  firstName              String        @db.VarChar(100)
  lastName               String        @db.VarChar(100)
  email                  String        @db.VarChar(255)
  phone                  String?       @db.VarChar(50)
  companyName            String        @db.VarChar(255)
  website                String?       @db.VarChar(255)
  source                 String        @db.VarChar(100)
  status                 String        @default("new") @db.VarChar(50) // new, contacted, qualified, nurturing, unqualified, converted
  score                  Int           @default(0)
  budget                 Decimal?      @db.Decimal(18, 4)
  convertedAt            DateTime?     @db.Timestamptz(6)
  convertedAccountId     String?       @db.Uuid
  convertedContactId     String?       @db.Uuid
  convertedOpportunityId String?       @db.Uuid
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?     @db.Timestamptz(6)

  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                  User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([ownerId])
  @@index([email])
  @@index([companyName])
  @@map("leads")
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
}

enum ContactRole {
  DECISION_MAKER
  INFLUENCER
  GATEKEEPER
  USER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

model Account {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String         @db.Uuid
  parentAccountId String?        @db.Uuid
  name            String         @db.VarChar(255)
  domain          String         @db.VarChar(255)
  industry        String?        @db.VarChar(100)
  employeeCount   Int?
  annualRevenue   Decimal?       @db.Decimal(18, 2)
  billingStreet   String?        @db.VarChar(255)
  billingCity     String?        @db.VarChar(100)
  billingCountry  String         @db.VarChar(100)
  status          AccountStatus  @default(ACTIVE)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?      @db.Timestamptz(6)
  createdBy       String?        @db.Uuid
  updatedBy       String?        @db.Uuid

  organization    Organization   @relation(fields: [organizationId], references: [id])
  parentAccount   Account?       @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: Restrict)
  subsidiaries    Account[]      @relation("AccountHierarchy")
  contacts        Contact[]

  @@index([organizationId])
  @@index([parentAccountId])
  @@map("accounts")
}

model Contact {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @db.Uuid
  accountId        String         @db.Uuid
  firstName        String         @db.VarChar(100)
  lastName         String         @db.VarChar(100)
  email            String         @db.VarChar(255)
  phone            String?        @db.VarChar(50)
  jobTitle         String?        @db.VarChar(150)
  department       String?        @db.VarChar(100)
  roleScope        ContactRole    @default(USER)
  isPrimaryBilling Boolean        @default(false)
  status           ContactStatus  @default(ACTIVE)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)
  createdBy        String?        @db.Uuid
  updatedBy        String?        @db.Uuid

  organization     Organization   @relation(fields: [organizationId], references: [id])
  account          Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([accountId])
  @@map("contacts")
}

